# Zoldify Backend — mẫu cấu hình
#
# Chép thành .env rồi điền. KHÔNG commit .env.
#     cp .env.sample .env
#
# 25 biến dưới đây được quét trực tiếp từ mã nguồn (process.env và
# configService.get), không phải chép tay, nên không thiếu cái nào.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Máy chưa cài MySQL thì dựng bằng Docker, nhanh hơn cài đặt:
#   docker run -d --name zoldify-mysql \
#     -e MYSQL_ROOT_PASSWORD=zoldify -e MYSQL_DATABASE=zoldify_dev \
#     -p 3306:3306 mysql:8
# Rồi chạy migration:  npm run migration:run
# Rồi đổ dữ liệu mẫu:  npm run seed
#
# CHẠY CẢ CỤM BẰNG COMPOSE thì không cần lệnh trên — compose tự dựng MySQL:
#   npm run docker:up
# Lúc đó DB_HOST bên dưới bị compose ghi đè thành `mysql` (tên dịch vụ trong
# mạng nội bộ), còn DB_PASSWORD ở đây trở thành mật khẩu root của MySQL trong
# cụm. Để trống là compose dừng, không dựng database mật khẩu rỗng.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=zoldify_dev

# ---------------------------------------------------------------------------
# Máy chủ
# ---------------------------------------------------------------------------
PORT=3000
# Cổng trên MÁY CHỦ mà cụm Docker mở ra. Chỉ docker-compose.yml đọc biến này;
# bên trong container ứng dụng luôn nghe cổng 3000.
API_PORT=3000
# Gốc công khai của chính API này, dùng để ghép URL trả về cho client
API_PUBLIC_URL=http://localhost:3000
# Gốc của web, dùng cho link trong email và returnUrl của PayOS
SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Sinh chuỗi ngẫu nhiên, mỗi môi trường một chuỗi khác nhau:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_EXPIRE=7d

# ---------------------------------------------------------------------------
# Email — dùng để gửi OTP đăng ký và đặt lại mật khẩu
# ---------------------------------------------------------------------------
# Gmail đòi App Password chứ không nhận mật khẩu tài khoản thường.
# Bật xác thực 2 bước rồi vào https://myaccount.google.com/apppasswords
#
# Điền xong thì thử ngay, đừng đợi tới lúc đăng ký:  npm run mail:test
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# TÀI KHOẢN ĐĂNG NHẬP vào máy chủ SMTP. Với Gmail thì đây phải là một tài khoản
# Google thật (@gmail.com, hoặc tên miền đã mua Workspace). Điền tên miền dùng
# dịch vụ chuyển tiếp (Cloudflare Email Routing, ImprovMX) vào đây thì Gmail trả
# về 535 BadCredentials — nghe như sai mật khẩu, thật ra là không có tài khoản.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# ĐỊA CHỈ NGƯỜI NHẬN NHÌN THẤY. Để trống thì dùng luôn EMAIL_USER.
#
# Muốn thư đề tên miền riêng mà vẫn đăng nhập bằng Gmail: vào Gmail > Cài đặt >
# Tài khoản > "Gửi thư bằng địa chỉ", thêm và xác minh địa chỉ đó, rồi điền vào
# đây. Gmail chỉ nhận bí danh ĐÃ xác minh trên chính tài khoản đang đăng nhập.
#
# ⚠️ Còn phải thêm `include:_spf.google.com` vào bản ghi TXT (SPF) của tên miền,
# không thì thư vẫn gửi đi được nhưng rơi vào spam của người nhận — hỏng kiểu
# không báo lỗi. `npm run mail:test` tự tra và cảnh báo giúp.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# PayOS — cổng thanh toán
# ---------------------------------------------------------------------------
# Lấy ở https://my.payos.vn, mục Kênh thanh toán.
# Để trống thì backend vẫn chạy, chỉ luồng thanh toán là hỏng.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_HOST=https://api-merchant.payos.vn

# ---------------------------------------------------------------------------
# SePay — đối soát biến động số dư ngân hàng
# ---------------------------------------------------------------------------
SEPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GHN — vận chuyển
# ---------------------------------------------------------------------------
# Token lấy ở https://khachhang.ghn.vn. Thiếu thì đơn vẫn xác nhận được,
# chỉ không có mã vận đơn (mã lỗi được nuốt có chủ đích).
GHN_TOKEN=
GHN_SHOP_ID=
GHN_HOST=https://dev-online-gateway.ghn.vn
# Mã quận của kho gửi hàng, tra bằng API địa chỉ của GHN
GHN_FROM_DISTRICT_ID=

# ---------------------------------------------------------------------------
# Cloudflare R2 — kho ảnh/file (S3-compatible)
# ---------------------------------------------------------------------------
# Để TRỐNG cả cụm thì upload lưu vào đĩa public/images như cũ. Điền đủ 5 biến
# đầu thì /files/upload đẩy thẳng lên R2 và trả URL công khai.
#   Tạo bucket + API token (Object Read & Write) ở Cloudflare > R2.
#   Gắn custom domain (vd img.zoldify.com) cho bucket để phục vụ qua CDN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://img.zoldify.com
# Tuỳ chọn: tiền tố key để tách môi trường (staging đặt "staging/"), prod để trống
R2_KEY_PREFIX=

# ---------------------------------------------------------------------------
# Database cho test tự động — KHÔNG trỏ vào database thật
# ---------------------------------------------------------------------------
# Bộ test ledger xoá sạch bảng trước mỗi ca. Trỏ nhầm vào DB làm việc là
# mất dữ liệu. Dựng riêng một container:
#   npm run test:db
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=root
TEST_DB_PASSWORD=testpw
TEST_DB_NAME=zoldify_test
