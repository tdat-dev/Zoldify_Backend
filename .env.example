# =============================================
# Zoldify Backend - Cấu hình Biến môi trường (.env.example)
# =============================================
# Sao chép file này thành .env và điền thông tin phù hợp:
# cp .env.example .env
# =============================================

# --- Cấu hình Server ---
PORT=3000

# --- Cấu hình Cơ sở dữ liệu (MySQL) ---
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=zoldify

# --- Cấu hình JWT (Xác thực người dùng) ---
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRE=
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_EXPIRE=

# --- Cấu hình Email (Gmail SMTP) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- Frontend URL (dùng cho CORS, redirect, sitemap) ---
SITE_URL=

# --- Cổng thanh toán PayOS ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_HOST=

# --- SePay (Webhook thanh toán) ---
SEPAY_WEBHOOK_SECRET=

# --- GHN (Giao Hàng Nhanh API) ---
GHN_HOST=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
