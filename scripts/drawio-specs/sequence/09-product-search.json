{
  "name": "Product Search",
  "title": "Product Search by keyword",
  "lifelines": [
    {"id": "u", "label": "User", "kind": "actor"},
    {"id": "app", "label": "«client»\n:ClientApp", "kind": "object"},
    {"id": "ctl", "label": ":ProductsController", "kind": "object"},
    {"id": "svc", "label": ":ProductsService", "kind": "object"},
    {"id": "db", "label": "«database»\n:MySQL", "kind": "object"}
  ],
  "steps": [
    {"msg": "sync", "from": "u", "to": "app", "label": "enter keyword \"giay\", tap Search"},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "GET /products?q=giay&current=1&pageSize=10"},
    {"msg": "sync", "from": "ctl", "to": "svc", "label": "findAll(current, pageSize, qs)"},
    {"msg": "self", "on": "svc", "label": "offset = (current - 1) * pageSize; order by sort"},
    {"frag": "alt", "guardOn": "svc", "operands": [
      {"guard": "[q has 4+ characters]", "steps": [
        {"msg": "self", "on": "svc", "label": "WHERE MATCH(name, description)\nAGAINST('giay*' IN BOOLEAN MODE)"}
      ]},
      {"guard": "[else]", "steps": [
        {"msg": "self", "on": "svc", "label": "WHERE name LIKE '%q%'"}
      ]}
    ]},
    {"msg": "self", "on": "svc", "label": "andWhere category, price range, condition"},
    {"msg": "sync", "from": "svc", "to": "db", "label": "getManyAndCount() LIMIT pageSize OFFSET"},
    {"msg": "reply", "from": "db", "to": "svc", "label": "[products + category], total"},
    {"msg": "self", "on": "svc", "label": "pages = ceil(total / pageSize)"},
    {"msg": "reply", "from": "svc", "to": "ctl", "label": "{meta, result}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "200 {data: {meta, result}}"},
    {"msg": "reply", "from": "app", "to": "u", "label": "render search results"}
  ]
}
