{
  "name": "Shop",
  "title": "View seller shop page",
  "lifelines": [
    {"id": "u", "label": "User", "kind": "actor"},
    {"id": "app", "label": "«client»\n:ClientApp", "kind": "object"},
    {"id": "ctl", "label": ":ShopController", "kind": "object"},
    {"id": "svc", "label": ":ShopService", "kind": "object"},
    {"id": "db", "label": "«database»\n:MySQL", "kind": "object"}
  ],
  "steps": [
    {"msg": "sync", "from": "u", "to": "app", "label": "tap seller name"},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "GET /shop/:sellerId (public)"},
    {"msg": "sync", "from": "ctl", "to": "svc", "label": "getShopInfo(sellerId)"},
    {"msg": "sync", "from": "svc", "to": "db", "label": "SELECT shop + user WHERE user_id"},
    {"msg": "reply", "from": "db", "to": "svc", "label": "Shop | null"},
    {"frag": "opt", "guardOn": "svc", "operands": [{"guard": "[no shop row]", "steps": [
      {"msg": "sync", "from": "svc", "to": "db", "label": "SELECT user WHERE id"},
      {"msg": "reply", "from": "db", "to": "svc", "label": "User | null"},
      {"frag": "break", "guardOn": "svc", "operands": [{"guard": "[user not found]", "steps": [
        {"msg": "reply", "from": "svc", "to": "ctl", "label": "BadRequestException"},
        {"msg": "reply", "from": "ctl", "to": "app", "label": "400 Shop not found"},
        {"msg": "reply", "from": "app", "to": "u", "label": "show error"}
      ]}]},
      {"msg": "self", "on": "svc", "label": "shop = {name: full_name, logo: avatar}"}
    ]}]},
    {"frag": "par", "guardOn": "svc", "operands": [
      {"guard": "[active products]", "steps": [
        {"msg": "sync", "from": "svc", "to": "db", "label": "COUNT products WHERE seller, ACTIVE"},
        {"msg": "reply", "from": "db", "to": "svc", "label": "productCount"}
      ]},
      {"guard": "[followers]", "steps": [
        {"msg": "sync", "from": "svc", "to": "db", "label": "COUNT follows WHERE following = seller"},
        {"msg": "reply", "from": "db", "to": "svc", "label": "followerCount"}
      ]}
    ]},
    {"msg": "reply", "from": "svc", "to": "ctl", "label": "{...shop, productCount, followerCount}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "200 {shop info}"},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "GET /shop/:sellerId/products?page&limit"},
    {"msg": "sync", "from": "ctl", "to": "svc", "label": "getShopProducts(sellerId, page||1, limit||20)"},
    {"msg": "sync", "from": "svc", "to": "db", "label": "SELECT products + category, COUNT(*)\nWHERE seller, ACTIVE LIMIT/OFFSET"},
    {"msg": "reply", "from": "db", "to": "svc", "label": "[Product[], total]"},
    {"msg": "reply", "from": "svc", "to": "ctl", "label": "{meta, result}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "200 {meta, result}"},
    {"msg": "reply", "from": "app", "to": "u", "label": "show shop info and products"}
  ]
}
