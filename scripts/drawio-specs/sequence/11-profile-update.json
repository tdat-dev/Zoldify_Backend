{
  "name": "Profile Update",
  "title": "Profile Update (avatar, phone number)",
  "lifelines": [
    {"id": "u", "label": "User", "kind": "actor"},
    {"id": "app", "label": "«client»\n:ClientApp", "kind": "object"},
    {"id": "fc", "label": ":FilesController", "kind": "object"},
    {"id": "ctl", "label": ":AuthController", "kind": "object"},
    {"id": "svc", "label": ":AuthService", "kind": "object"},
    {"id": "db", "label": "«database»\n:MySQL", "kind": "object"},
    {"id": "r2", "label": "«external»\n:CloudflareR2", "kind": "object"}
  ],
  "steps": [
    {"msg": "sync", "from": "u", "to": "app", "label": "change avatar and phone number, Save"},
    {"frag": "opt", "guardOn": "app", "operands": [{"guard": "[new avatar picked]", "steps": [
      {"msg": "sync", "from": "app", "to": "fc", "label": "POST /files/upload (fileUpload, folder_type)"},
      {"msg": "sync", "from": "fc", "to": "r2", "label": "storage.upload(): PutObject(key, buffer)"},
      {"msg": "reply", "from": "r2", "to": "fc", "label": "public URL"},
      {"msg": "sync", "from": "fc", "to": "db", "label": "filesService.create(): INSERT files"},
      {"msg": "reply", "from": "db", "to": "fc", "label": "FileEntity"},
      {"msg": "reply", "from": "fc", "to": "app", "label": "201 {url}"}
    ]}]},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "PATCH /auth/profile {avatar, phone_number}"},
    {"msg": "self", "on": "ctl", "label": "JwtAuthGuard: verify access token"},
    {"frag": "break", "guardOn": "ctl", "operands": [{"guard": "[token invalid or revoked]", "steps": [
      {"msg": "reply", "from": "ctl", "to": "app", "label": "401 Unauthorized"}
    ]}]},
    {"msg": "sync", "from": "ctl", "to": "svc", "label": "updateProfile(userId, ..., avatar, phone_number)"},
    {"msg": "sync", "from": "svc", "to": "db", "label": "findOne users WHERE id"},
    {"msg": "reply", "from": "db", "to": "svc", "label": "User | null"},
    {"frag": "break", "guardOn": "svc", "operands": [{"guard": "[user not found]", "steps": [
      {"msg": "reply", "from": "svc", "to": "ctl", "label": "NotFoundException"},
      {"msg": "reply", "from": "ctl", "to": "app", "label": "404 Not Found"}
    ]}]},
    {"msg": "self", "on": "svc", "label": "build patch from fields sent (trim)"},
    {"frag": "opt", "guardOn": "svc", "operands": [{"guard": "[patch not empty]", "steps": [
      {"msg": "sync", "from": "svc", "to": "db", "label": "UPDATE users SET avatar, phone_number"},
      {"msg": "reply", "from": "db", "to": "svc", "label": "ok"}
    ]}]},
    {"msg": "reply", "from": "svc", "to": "ctl", "label": "{id, full_name, avatar, phone_number, ...}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "200 profile"},
    {"msg": "reply", "from": "app", "to": "u", "label": "show updated profile"}
  ]
}
