{
  "name": "Password Reset",
  "title": "Reset password with email OTP",
  "lifelines": [
    {"id": "u", "label": "User", "kind": "actor"},
    {"id": "app", "label": "«client»\n:ClientApp", "kind": "object"},
    {"id": "ctl", "label": ":AuthController", "kind": "object"},
    {"id": "auth", "label": ":AuthService", "kind": "object"},
    {"id": "db", "label": "«database»\n:MySQL", "kind": "object"},
    {"id": "cache", "label": "«cache»\n:CacheManager", "kind": "object"},
    {"id": "smtp", "label": "«external»\n:SMTP", "kind": "object"}
  ],
  "steps": [
    {"msg": "sync", "from": "u", "to": "app", "label": "enter email, tap Forgot password"},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "POST /auth/forgot-password/send-otp {email}"},
    {"msg": "sync", "from": "ctl", "to": "auth", "label": "sendForgotPasswordOtp(email)"},
    {"msg": "sync", "from": "auth", "to": "db", "label": "findOne({email})"},
    {"msg": "reply", "from": "db", "to": "auth", "label": "User | null"},
    {"frag": "break", "guardOn": "auth", "operands": [
      {"guard": "[no account with this email]", "steps": [
        {"msg": "reply", "from": "auth", "to": "ctl", "label": "NotFoundException"},
        {"msg": "reply", "from": "ctl", "to": "app", "label": "404 Not Found"},
        {"msg": "reply", "from": "app", "to": "u", "label": "show error"}
      ]}
    ]},
    {"msg": "self", "on": "auth", "label": "generate 6-digit OTP"},
    {"msg": "sync", "from": "auth", "to": "cache", "label": "set(forgot_otp_{email}, otp, 300 s)"},
    {"msg": "reply", "from": "cache", "to": "auth", "label": "ok"},
    {"msg": "sync", "from": "auth", "to": "smtp", "label": "sendMail(email, OTP html)"},
    {"msg": "reply", "from": "smtp", "to": "auth", "label": "sent | error"},
    {"frag": "break", "guardOn": "auth", "operands": [
      {"guard": "[sending failed]", "steps": [
        {"msg": "reply", "from": "auth", "to": "ctl", "label": "BadRequestException"},
        {"msg": "reply", "from": "ctl", "to": "app", "label": "400 Bad Request"},
        {"msg": "reply", "from": "app", "to": "u", "label": "show error"}
      ]}
    ]},
    {"msg": "reply", "from": "auth", "to": "ctl", "label": "{message}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "201 {message: OTP sent}"},
    {"msg": "reply", "from": "app", "to": "u", "label": "show OTP and new password form"},
    {"msg": "async", "from": "smtp", "to": "u", "label": "email with 6-digit OTP"},
    {"msg": "sync", "from": "u", "to": "app", "label": "enter OTP, new password"},
    {"msg": "sync", "from": "app", "to": "ctl", "label": "POST /auth/forgot-password/reset\n{email, otp, newPassword}"},
    {"msg": "sync", "from": "ctl", "to": "auth", "label": "resetPassword(email, otp, newPassword)"},
    {"msg": "sync", "from": "auth", "to": "cache", "label": "get(forgot_otp_{email})"},
    {"msg": "reply", "from": "cache", "to": "auth", "label": "otp | undefined"},
    {"frag": "break", "guardOn": "auth", "operands": [
      {"guard": "[OTP expired or wrong]", "steps": [
        {"msg": "reply", "from": "auth", "to": "ctl", "label": "BadRequestException"},
        {"msg": "reply", "from": "ctl", "to": "app", "label": "400 Bad Request"},
        {"msg": "reply", "from": "app", "to": "u", "label": "show error"}
      ]}
    ]},
    {"msg": "sync", "from": "auth", "to": "db", "label": "findOne({email})"},
    {"msg": "reply", "from": "db", "to": "auth", "label": "User | null"},
    {"frag": "break", "guardOn": "auth", "operands": [
      {"guard": "[user not found]", "steps": [
        {"msg": "reply", "from": "auth", "to": "ctl", "label": "NotFoundException"},
        {"msg": "reply", "from": "ctl", "to": "app", "label": "404 Not Found"},
        {"msg": "reply", "from": "app", "to": "u", "label": "show error"}
      ]}
    ]},
    {"msg": "self", "on": "auth", "label": "hashPassword(newPassword) (bcrypt)"},
    {"msg": "sync", "from": "auth", "to": "db", "label": "UPDATE users SET password"},
    {"msg": "reply", "from": "db", "to": "auth", "label": "UpdateResult"},
    {"msg": "sync", "from": "auth", "to": "cache", "label": "del(forgot_otp_{email})"},
    {"msg": "reply", "from": "cache", "to": "auth", "label": "ok"},
    {"msg": "reply", "from": "auth", "to": "ctl", "label": "{message}"},
    {"msg": "reply", "from": "ctl", "to": "app", "label": "201 {message: password reset}"},
    {"msg": "reply", "from": "app", "to": "u", "label": "ask to log in again"},
    {"note": "OTP lives in the in-process cache-manager\nmemory store (no Redis), TTL 5 minutes", "over": ["db", "cache"]}
  ]
}
