{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "node scripts/check-lint.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node src/seed.ts",
    "seed:withdrawals": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-withdrawals.ts",
    "openapi:gen": "nest build && node dist/openapi-export.js",
    "openapi:check": "npm run openapi:gen && git diff --exit-code openapi.json",
    "mock": "prism mock openapi.json --port 4200",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "migration:generate": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "test:db": "node scripts/test-db.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:migrate": "docker compose run --rm migrate",
    "mail:test": "node scripts/test-smtp.mjs",
    "env:check": "node scripts/check-env.mjs",
    "diagrams:export": "node scripts/export-diagrams.mjs",
    "diagrams:check": "node scripts/export-diagrams.mjs --check",
    "drawio:make": "node scripts/make-drawio.mjs",
    "drawio:check": "node scripts/check-drawio.mjs",
    "drawio:shoot": "node scripts/shoot-drawio.mjs",
    "categories:relink": "node -r ts-node/register -r tsconfig-paths/register scripts/relink-category-images.ts",
    "seed:demo": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-demo-catalog.ts",
    "seed:orders": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-1000-orders.ts",
    "seed:products": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-1000-products.ts",
    "seed:bulk": "node -r ts-node/register -r tsconfig-paths/register scripts/seed-bulk.ts",
    "check": "node -r ts-node/register -r tsconfig-paths/register scripts/selfcheck-all.ts",
    "check:core": "node -r ts-node/register -r tsconfig-paths/register scripts/selfcheck.ts",
    "check:index": "node -r ts-node/register -r tsconfig-paths/register scripts/selfcheck-indexes.ts",
    "check:cache": "node -r ts-node/register -r tsconfig-paths/register scripts/selfcheck-cache.ts",
    "check:ci": "node -r ts-node/register -r tsconfig-paths/register scripts/selfcheck-ci.ts",
    "loadtest": "k6 run load-test/baseline.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@keyv/redis": "^5.1.6",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.23",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@nestjs/websockets": "^11.1.23",
    "@payos/node": "^2.0.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "^1.8.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "keyv": "^5.6.0",
    "ms": "^2.1.3",
    "mysql2": "3.22.3",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "0.3.29"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stoplight/prism-cli": "^5.14.2",
    "@types/bcrypt": "^6.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "js-yaml": "^5.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
