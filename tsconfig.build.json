{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",

    // Các script công cụ chạy riêng bằng ts-node hoặc node, không thuộc ứng
    // dụng. Để chúng trong build thì tsc lấy gốc chung của mọi file nguồn là
    // thư mục dự án chứ không phải src, nên đầu ra thành dist/src/main.js —
    // và cả `start:prod` lẫn `openapi:gen` đều trỏ sai đường dẫn.
    "scripts"
  ]
}
