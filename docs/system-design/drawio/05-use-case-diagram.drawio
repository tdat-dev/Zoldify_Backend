          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-12" edge="1" parent="1" source="m5nynqLc1Hzq-eZqEtPv-3" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="m5nynqLc1Hzq-eZqEtPv-4" value="3a · delivered, 95%">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-13" edge="1" parent="1" source="m5nynqLc1Hzq-eZqEtPv-3" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="m5nynqLc1Hzq-eZqEtPv-5" value="3b · platform fee, 5%">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-14" edge="1" parent="1" source="m5nynqLc1Hzq-eZqEtPv-4" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" target="m5nynqLc1Hzq-eZqEtPv-6" value="5 · seller requests">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-15" edge="1" parent="1" source="m5nynqLc1Hzq-eZqEtPv-6" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" target="m5nynqLc1Hzq-eZqEtPv-4" value="6a · rejected">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-16" edge="1" parent="1" source="m5nynqLc1Hzq-eZqEtPv-6" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="m5nynqLc1Hzq-eZqEtPv-7" value="6b · transfer completed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m5nynqLc1Hzq-eZqEtPv-17" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="The yellow box is the single most important number in the system. Its balance&lt;br&gt;must always equal the real money sitting in Zoldify&#39;s bank account.&lt;br&gt;&lt;br&gt;It answers the first question any auditor, investor or payment partner asks:&lt;br&gt;&quot;How much of your users&#39; money are you holding, and how do you prove it?&quot;&lt;br&gt;One SQL query. The old architecture could not answer it at all.&lt;br&gt;&lt;br&gt;Steps 5 and 6 are separate because the payout is a human action. Between them&lt;br&gt;the money has left the seller&#39;s wallet but not the system — without a dedicated&lt;br&gt;account for that state, the books cannot be reconciled against the bank." vertex="1">
          <mxGeometry height="160" width="720" x="70" y="570" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
