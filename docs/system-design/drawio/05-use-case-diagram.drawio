        <mxCell id="Dr732kjv7UyW1QPMPvEX-35" edge="1" parent="1" source="Dr732kjv7UyW1QPMPvEX-16" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="Dr732kjv7UyW1QPMPvEX-17" value="COMMIT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-36" edge="1" parent="1" source="Dr732kjv7UyW1QPMPvEX-17" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Dr732kjv7UyW1QPMPvEX-18" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-37" edge="1" parent="1" source="Dr732kjv7UyW1QPMPvEX-17" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="Dr732kjv7UyW1QPMPvEX-19" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-38" edge="1" parent="1" source="Dr732kjv7UyW1QPMPvEX-18" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="Dr732kjv7UyW1QPMPvEX-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-39" edge="1" parent="1" source="Dr732kjv7UyW1QPMPvEX-18" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="Dr732kjv7UyW1QPMPvEX-19" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1680" y="1370" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-40" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Why the dashed frame — and the bug it replaced&lt;br&gt;&lt;br&gt;The refund, the status change and the stock restore are ONE transaction. If&lt;br&gt;the refund throws, none of the other two happened: the order stays open and&lt;br&gt;the buyer can try again.&lt;br&gt;&lt;br&gt;Until 14 Aug this was three separate writes, and the refund call sat inside a&lt;br&gt;try/catch that only console.error-ed the failure — then saved the order as&lt;br&gt;cancelled anyway. A failed refund left the buyer money in escrow_hold forever&lt;br&gt;with nothing raising an alarm. escrows.refund() was always correct on its own;&lt;br&gt;the defect was the caller swallowing what it threw.&lt;br&gt;&lt;br&gt;Exactly one failure is still swallowed on purpose: an order paid before the&lt;br&gt;escrow system existed has no escrow row to refund. That one logs a warning and&lt;br&gt;lets the cancel through. Every other error rolls the whole thing back." vertex="1">
          <mxGeometry height="240" width="800" x="600" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="Dr732kjv7UyW1QPMPvEX-41" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Two safety nets, because voiding the link can fail&lt;br&gt;&lt;br&gt;Voiding runs AFTER the commit and never throws: it is a network call to PayOS,&lt;br&gt;and holding database locks across a network wait is how deadlocks are made.&lt;br&gt;If it fails, the link stays alive and someone can still pay a cancelled order.&lt;br&gt;&lt;br&gt;The second net catches that. The payment webhook now checks the order status&lt;br&gt;first: if the order is cancelled the money is credited to the BUYER WALLET and&lt;br&gt;the order stays cancelled — see 06-activity-diagram. It cannot be ignored,&lt;br&gt;because the money is already in the real bank account; not recording it would&lt;br&gt;put gateway_clearing out of step with the bank.&lt;br&gt;&lt;br&gt;Until 14 Aug neither net existed: the webhook set status = confirmed without&lt;br&gt;looking, so a cancelled order came back to life while its stock had already&lt;br&gt;been returned to the shelf." vertex="1">
          <mxGeometry height="240" width="800" x="1440" y="1500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
