        <mxCell id="note" parent="1" value="Every use case except &lt;i&gt;Browse &amp;amp; search items&lt;/i&gt;, &lt;i&gt;Register an account&lt;/i&gt; and &lt;i&gt;Sign in&lt;/i&gt; requires a signed-in User. This precondition is stated here instead of drawing an «include» to &lt;i&gt;Sign in&lt;/i&gt; from every use case." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=#FFFDE7;strokeColor=#BDB76B;fontSize=12;fontColor=#3C4043;" vertex="1">
          <mxGeometry x="280" y="1810" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lg" parent="1" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;Solid line: actor takes part in the use case&lt;br&gt;Dashed «include»: base always runs the included use case&lt;br&gt;Dashed «extend»: optional behaviour, arrow points to the base&lt;br&gt;Hollow triangle: generalization (Buyer and Seller are Users)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fillColor=#FAFAFA;strokeColor=#BDC1C6;fontSize=12;fontColor=#3C4043;" vertex="1">
          <mxGeometry x="860" y="1810" width="560" height="100" as="geometry" />
