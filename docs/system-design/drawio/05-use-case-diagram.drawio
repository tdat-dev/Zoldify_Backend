        <mxCell id="n49" value="" style="endArrow=block;endFill=0;endSize=14;html=1;strokeColor=#333333;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n50" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n51" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n52" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n53" value="Notation. Actors are stick figures, use cases are ellipses, and the box is&lt;br&gt;the system boundary. The hollow triangle is generalisation: Buyer and&lt;br&gt;Seller are both a Registered User, so they inherit those three use cases&lt;br&gt;instead of being wired to them twice.&lt;br&gt;&lt;br&gt;PayOS and GHN are secondary actors. They start nothing — the system calls&lt;br&gt;them to finish a goal that a primary actor asked for. That is why no use&lt;br&gt;case here is named after a webhook or an API call: those are mechanisms,&lt;br&gt;not goals, and a use case must be a goal.&lt;br&gt;&lt;br&gt;«include» means the target runs every time the source runs. Placing an&lt;br&gt;order always takes a payment; confirming delivery always releases the&lt;br&gt;money held in escrow." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="250" y="1300" width="640" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
