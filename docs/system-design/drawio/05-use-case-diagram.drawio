        <mxCell id="tGW9B6DTG3zimptHfNuc-40" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-7" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="tGW9B6DTG3zimptHfNuc-5" value="yes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="80" y="432" />
              <mxPoint x="80" y="322" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-41" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-7" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-8" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-42" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-8" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="tGW9B6DTG3zimptHfNuc-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-43" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-17" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-44" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-18" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-45" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-19" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="tGW9B6DTG3zimptHfNuc-26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-46" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-19" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-47" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-20" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-48" edge="1" parent="1" source="tGW9B6DTG3zimptHfNuc-21" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="tGW9B6DTG3zimptHfNuc-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-49" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Three red boxes, three real defects&lt;br&gt;&lt;br&gt;1. THE URL IS BUILT FROM THE REQUEST. files.controller.ts writes&lt;br&gt;   `${req.protocol}://${req.get(host)}/public/images/...` into the database.&lt;br&gt;   Every photo therefore carries whichever hostname the uploader happened to&lt;br&gt;   reach. Behind a reverse proxy that is http://localhost:3000; after a domain&lt;br&gt;   change every older photo points at the old domain. The stored value should&lt;br&gt;   be the path, and the host should be added when reading.&lt;br&gt;&lt;br&gt;2. THE WHITELIST DROPS FIELDS WITHOUT SAYING SO. products.service.create()&lt;br&gt;   copies a fixed list of fields. A field the DTO accepted but the list forgot&lt;br&gt;   is discarded and the API still answers 201. This already happened once with&lt;br&gt;   `currency`: send USD, get 201, row says VND.&lt;br&gt;&lt;br&gt;3. NOTHING REVIEWS THE LISTING. It is visible the moment it is saved. For a&lt;br&gt;   second-hand marketplace whose selling point is trust, that is the gap a&lt;br&gt;   grader will ask about." vertex="1">
          <mxGeometry height="300" width="830" x="50" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="tGW9B6DTG3zimptHfNuc-50" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Why the loop is drawn instead of one upload step&lt;br&gt;&lt;br&gt;The route uses FileInterceptor(fileUpload) — SINGLE file. The multer config&lt;br&gt;allows files: 10, which reads like ten photos per request, but that limit&lt;br&gt;never applies: the interceptor accepts one field, one file. A client with six&lt;br&gt;photos makes six requests and assembles the URL list itself.&lt;br&gt;&lt;br&gt;Consequence worth saying out loud: those six uploads are not one transaction.&lt;br&gt;If the browser closes after the fourth, four files sit on disk and in `files`&lt;br&gt;with no product pointing at them. Nothing collects them.&lt;br&gt;&lt;br&gt;fileSize is 100MB per file — for a marketplace photo that is roughly fifty&lt;br&gt;times what is needed, and it is the whole VPS disk on the line." vertex="1">
          <mxGeometry height="300" width="830" x="910" y="1260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
