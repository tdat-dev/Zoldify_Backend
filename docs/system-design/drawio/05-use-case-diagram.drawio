            <mxPoint x="410" y="260" as="sourcePoint" />
            <mxPoint x="690" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-13" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="4. BEGIN TRANSACTION">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="300" as="sourcePoint" />
            <mxPoint x="1010" y="300" as="targetPoint" />
          </mxGeometry>
