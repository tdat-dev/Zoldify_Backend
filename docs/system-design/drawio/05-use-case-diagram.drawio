        <mxCell id="31tzUzGOhUYmU4UAErBF-22" edge="1" parent="1" source="31tzUzGOhUYmU4UAErBF-6" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="31tzUzGOhUYmU4UAErBF-9" value="RELEASE escrow">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="835" y="694" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="31tzUzGOhUYmU4UAErBF-23" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Every arrow into the final state moves money. That is why authorization on&lt;br&gt;this state machine is a financial control, not a UX detail.&lt;br&gt;&lt;br&gt;Who may make each move — enforced by order-status.policy.ts:&lt;br&gt;  confirmed / processing / shipping ....... seller or admin&lt;br&gt;  delivered ............................... BUYER or admin, and only from shipping&lt;br&gt;  refunded ................................ admin only&lt;br&gt;  cancelled ............................... neither; use /cancel or /cancel-sale,&lt;br&gt;                                            those also restore stock&lt;br&gt;&lt;br&gt;The principle: whoever gains must not be the one who presses the button.&lt;br&gt;A seller marking their own order delivered would be releasing their own escrow." vertex="1">
          <mxGeometry height="180" width="700" x="50" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
