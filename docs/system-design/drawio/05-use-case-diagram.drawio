        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-29" edge="1" parent="1" source="viOyjuUb51sducoei_58-9" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="viOyjuUb51sducoei_58-10" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-30" edge="1" parent="1" source="viOyjuUb51sducoei_58-10" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="viOyjuUb51sducoei_58-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-31" edge="1" parent="1" source="viOyjuUb51sducoei_58-10" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="viOyjuUb51sducoei_58-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-32" edge="1" parent="1" source="viOyjuUb51sducoei_58-11" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="viOyjuUb51sducoei_58-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-33" edge="1" parent="1" source="viOyjuUb51sducoei_58-12" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="viOyjuUb51sducoei_58-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-34" edge="1" parent="1" source="viOyjuUb51sducoei_58-14" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" target="viOyjuUb51sducoei_58-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-35" edge="1" parent="1" source="viOyjuUb51sducoei_58-18" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#666666;fontSize=11;strokeColor=#c62828;" target="viOyjuUb51sducoei_58-19" value="days later">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-36" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="THE HALF THAT DOES NOT EXIST: STATUS SYNC&lt;br&gt;&lt;br&gt;Zoldify calls GHN once, stores order_code, and never speaks to GHN again.&lt;br&gt;There is no webhook route and no polling job. Search the repository for a GHN&lt;br&gt;callback and there is nothing to find.&lt;br&gt;&lt;br&gt;So picked up, in transit, delivered, delivery failed, returned to sender —&lt;br&gt;none of it reaches the order. `status` only moves when a human presses a&lt;br&gt;button in the seller UI.&lt;br&gt;&lt;br&gt;That matters more here than on an ordinary shop, because DELIVERED is the&lt;br&gt;event that releases the escrow. The money is waiting on a fact the system&lt;br&gt;cannot observe. Today a seller can mark their own order delivered and be paid&lt;br&gt;for a parcel that never left the house.&lt;br&gt;&lt;br&gt;Two ways to close it: register a GHN webhook, or poll the tracking endpoint on&lt;br&gt;a schedule. The webhook is cheaper and faster; polling survives a missed call." vertex="1">
          <mxGeometry height="300" width="800" x="50" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="viOyjuUb51sducoei_58-37" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Smaller things this diagram had to be honest about&lt;br&gt;&lt;br&gt;WEIGHT IS INVENTED. Every parcel is declared 500g, every line item 200g. GHN&lt;br&gt;prices by weight, so the quoted fee is fiction for anything heavier — and the&lt;br&gt;buyer already paid the quoted fee. Nothing in the product form asks for weight.&lt;br&gt;&lt;br&gt;THE FAILURE IS SWALLOWED ON PURPOSE, and that part is defensible: a shipment&lt;br&gt;is not money, and a seller can type the code in by hand. But it goes to&lt;br&gt;console.error, not the logger, so it lands nowhere anyone looks.&lt;br&gt;&lt;br&gt;service_type_id = 2 IS HARDCODED. If a district only offers another service&lt;br&gt;type, the order simply gets no shipment.&lt;br&gt;&lt;br&gt;THE CARRIER IS ONE FIXED PICKUP POINT — GHN_FROM_DISTRICT_ID out of the&lt;br&gt;environment. Every parcel is declared as leaving the same address, no matter&lt;br&gt;which seller it belongs to. That is a warehouse model, and Zoldify is a&lt;br&gt;marketplace of individuals." vertex="1">
          <mxGeometry height="300" width="800" x="880" y="1090" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lPV9rGajuQYiBNCSX1wS" name="Activity Diagram - Top Up the Wallet">
    <mxGraphModel dx="934" dy="572" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
