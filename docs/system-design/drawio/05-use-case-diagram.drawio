        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-14" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="5. SELECT ledger_transactions WHERE idempotency_key">
