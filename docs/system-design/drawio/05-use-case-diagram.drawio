        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-17" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="7. INSERT transaction, INSERT entries">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="460" as="sourcePoint" />
            <mxPoint x="1010" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-18" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="8. SELECT ledger_accounts FOR UPDATE, UPDATE balance">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="500" as="sourcePoint" />
            <mxPoint x="1010" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-19" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="9. UPDATE orders, INSERT escrows">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="540" as="sourcePoint" />
            <mxPoint x="1010" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-20" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="10. COMMIT">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="580" as="sourcePoint" />
            <mxPoint x="1010" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-21" parent="1" style="line;strokeWidth=1;html=1;dashed=1;strokeColor=#666666;fillColor=none;" value="" vertex="1">
          <mxGeometry height="10" width="550" x="550" y="610" as="geometry" />
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-22" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;" value="[key already used]" vertex="1">
          <mxGeometry height="18" width="220" x="560" y="620" as="geometry" />
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-23" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="7&#39;. COMMIT — nothing was written">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="670" as="sourcePoint" />
            <mxPoint x="1010" y="670" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-24" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="11. LedgerTransaction">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="740" as="sourcePoint" />
            <mxPoint x="410" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-25" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" value="12. notify buyer, after commit">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="790" as="sourcePoint" />
            <mxPoint x="1300" y="790" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-26" edge="1" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" value="13. 200 OK">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="840" as="sourcePoint" />
            <mxPoint x="140" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="D_lii-HTlHqN7Uhyi5Rq-27" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" value="Steps 4 to 10 are ONE transaction. The idempotency key and the money share a fate:&lt;br&gt;a crash rolls both back, so the retry succeeds cleanly. The old code committed the&lt;br&gt;key first, so a crash silently swallowed the payment.&lt;br&gt;&lt;br&gt;The lower branch is the normal path when PayOS resends the webhook, not an error.&lt;br&gt;LedgerService finds the existing row at step 5, writes nothing, and returns it —&lt;br&gt;so the caller gets the same LedgerTransaction it got the first time. That is what&lt;br&gt;makes the endpoint safe to retry any number of times." vertex="1">
          <mxGeometry height="130" width="700" x="70" y="1020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
