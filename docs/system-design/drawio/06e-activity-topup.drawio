        <mxCell id="n19" value="Money lands in the real&lt;br&gt;bank account" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n3"><mxGeometry x="25" y="545" width="290" height="55" as="geometry"/></mxCell>
