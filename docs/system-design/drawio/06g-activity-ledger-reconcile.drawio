        <mxCell id="n25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.986;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n28" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n32" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="EVERY BOX IS RED. NONE OF THIS EXISTS.&lt;br&gt;&lt;br&gt;Four places in the source already describe this job as though it runs:&lt;br&gt;ledger-account.entity.ts says an hourly job compares the two numbers,&lt;br&gt;orders.service.ts says the reconciliation job will spot the drift, seed.ts&lt;br&gt;says it surfaces in production, r6-state-escrow-lifecycle says an hourly&lt;br&gt;reconciliation job checks it.&lt;br&gt;&lt;br&gt;The only cron in the repository is TasksService.autoCancelOrders. There is no&lt;br&gt;reconciliation job. Comments described an intention and then were read back as&lt;br&gt;a description of the system — which is exactly how a team ends up believing it&lt;br&gt;has a safety net it does not have.&lt;br&gt;&lt;br&gt;This diagram is drawn to the same TO BE convention as the rest of the set: it&lt;br&gt;is the correct flow, drawn in red because it is not built. It is the smallest&lt;br&gt;piece of real work left that would most change what the system can promise." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="800" height="260" as="geometry"/></mxCell>
        <mxCell id="n36" value="Why it must not correct anything by itself&lt;br&gt;&lt;br&gt;A gap between the ledger and the cached balance means one of two things: the&lt;br&gt;ledger is right and the cache drifted, or something wrote money by a path&lt;br&gt;nobody knows about. Those need opposite responses, and the job cannot tell&lt;br&gt;them apart. A job that silently rewrites the balance to match destroys the&lt;br&gt;evidence of the second case — and the second case is the one that matters.&lt;br&gt;&lt;br&gt;So: record, alarm, freeze withdrawals, and let a person look. Freezing is the&lt;br&gt;part that is easy to leave out and expensive to leave out, because a&lt;br&gt;withdrawal is the one operation that turns a number in the database into money&lt;br&gt;that cannot be recalled.&lt;br&gt;&lt;br&gt;CHECK 1 is the invariant the whole double-entry design exists to guarantee, so&lt;br&gt;a failure there means a bug in LedgerService.post itself. CHECK 3 is the one&lt;br&gt;that catches the bugs found on 14 August: an escrow left HOLDING with no money&lt;br&gt;behind it shows up here and nowhere else." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="870" y="970" width="800" height="260" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
