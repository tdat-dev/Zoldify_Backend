        <mxCell id="n13" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="n2"><mxGeometry x="795" y="490" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n14" value="Write a discrepancy record&lt;br&gt;with the account and the gap" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe0e0;strokeColor=#c62828;" vertex="1" parent="n2"><mxGeometry x="160" y="540" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="n15" value="RAISE AN ALARM — do NOT auto-correct" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe0e0;strokeColor=#c62828;" vertex="1" parent="n2"><mxGeometry x="160" y="630" width="340" height="50" as="geometry"/></mxCell>
