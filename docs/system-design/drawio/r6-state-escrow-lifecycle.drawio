        <mxCell id="n7" value="order paid, money held" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n8" value="order delivered" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="order cancelled or refunded" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
