        <mxCell id="n14" value="The escrow_hold balance must ALWAYS match the real bank account.&lt;br&gt;An hourly reconciliation job checks it." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="25" y="300" width="330" height="55" as="geometry"/></mxCell>
        <mxCell id="n15" value="TERMINAL states. There is no way back.&lt;br&gt;To reverse one, post an opposite ledger transaction;&lt;br&gt;never edit the existing rows. ledger_entries is append-only." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="360" height="70" as="geometry"/></mxCell>
