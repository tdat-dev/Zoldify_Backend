        <mxCell id="n14" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="n2"><mxGeometry x="655" y="420" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n15" value="Write the file to&lt;br&gt;public/images/{folder_type}" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="440" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="n16" value="Build the URL from the REQUEST host&lt;br&gt;req.protocol + req.get(host)" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe0e0;strokeColor=#c62828;" vertex="1" parent="n2"><mxGeometry x="140" y="520" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="n17" value="Save a row in `files`, return the URL" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="600" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="n18" value="Validate the body against CreateProductDto" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="700" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="n19" value="Copy ONLY whitelisted fields&lt;br&gt;anything else is dropped in silence" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe0e0;strokeColor=#c62828;" vertex="1" parent="n2"><mxGeometry x="140" y="775" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="n20" value="Save the product, seller = caller" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="855" width="360" height="50" as="geometry"/></mxCell>
