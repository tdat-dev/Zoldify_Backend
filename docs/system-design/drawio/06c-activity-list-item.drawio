<mxfile host="app.diagrams.net" type="device">
  <diagram id="d1" name="Activity Diagram - List an Item for Sale">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="Seller" style="swimlane;html=1;startSize=28;horizontal=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="380" height="1180" as="geometry"/></mxCell>
        <mxCell id="n2" value="Zoldify Backend" style="swimlane;html=1;startSize=28;horizontal=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="1000" height="1180" as="geometry"/></mxCell>
        <mxCell id="n3" value="VPS disk · MySQL" style="swimlane;html=1;startSize=28;horizontal=1;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="1420" y="40" width="330" height="1180" as="geometry"/></mxCell>
        <mxCell id="n4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="n1"><mxGeometry x="175" y="60" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n5" value="Fill in the listing form:&lt;br&gt;name · price · condition · stock" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n1"><mxGeometry x="30" y="115" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="n6" value="ONE REQUEST PER IMAGE" style="rounded=0;html=1;fillColor=none;strokeColor=#b8860b;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#b8860b;" vertex="1" parent="n1"><mxGeometry x="20" y="210" width="340" height="250" as="geometry"/></mxCell>
        <mxCell id="n7" value="Pick one photo" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n1"><mxGeometry x="30" y="250" width="320" height="45" as="geometry"/></mxCell>
        <mxCell id="n8" value="POST /files/upload&lt;br&gt;header folder_type" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n1"><mxGeometry x="30" y="320" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="n9" value="Another&lt;br&gt;photo?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff8e1;strokeColor=#b8860b;" vertex="1" parent="n1"><mxGeometry x="105" y="395" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n10" value="POST /products with the returned URLs" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n1"><mxGeometry x="30" y="500" width="320" height="55" as="geometry"/></mxCell>
        <mxCell id="n11" value="Check the file extension" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="250" width="360" height="45" as="geometry"/></mxCell>
        <mxCell id="n12" value="jpg png gif webp&lt;br&gt;svg bmp pdf doc?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff8e1;strokeColor=#b8860b;" vertex="1" parent="n2"><mxGeometry x="230" y="320" width="180" height="90" as="geometry"/></mxCell>
