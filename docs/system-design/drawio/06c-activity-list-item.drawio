        <mxCell id="n22" value="Notify every follower of this seller" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="140" y="1005" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="n23" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="n2"><mxGeometry x="305" y="1085" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n24" value="File on the VPS disk" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n3"><mxGeometry x="30" y="440" width="270" height="50" as="geometry"/></mxCell>
