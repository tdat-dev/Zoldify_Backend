        <mxCell id="n35" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n24"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n36" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="665"/><mxPoint x="530" y="462"/></Array></mxGeometry></mxCell>
        <mxCell id="n40" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="422"/><mxPoint x="70" y="312"/></Array></mxGeometry></mxCell>
        <mxCell id="n41" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n42" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n43" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n44" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n45" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n46" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n47" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n21" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n48" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n49" value="Three red boxes, three real defects&lt;br&gt;&lt;br&gt;1. THE URL IS BUILT FROM THE REQUEST. files.controller.ts writes&lt;br&gt;   `${req.protocol}://${req.get(host)}/public/images/...` into the database.&lt;br&gt;   Every photo therefore carries whichever hostname the uploader happened to&lt;br&gt;   reach. Behind a reverse proxy that is http://localhost:3000; after a domain&lt;br&gt;   change every older photo points at the old domain. The stored value should&lt;br&gt;   be the path, and the host should be added when reading.&lt;br&gt;&lt;br&gt;2. THE WHITELIST DROPS FIELDS WITHOUT SAYING SO. products.service.create()&lt;br&gt;   copies a fixed list of fields. A field the DTO accepted but the list forgot&lt;br&gt;   is discarded and the API still answers 201. This already happened once with&lt;br&gt;   `currency`: send USD, get 201, row says VND.&lt;br&gt;&lt;br&gt;3. NOTHING REVIEWS THE LISTING. It is visible the moment it is saved. For a&lt;br&gt;   second-hand marketplace whose selling point is trust, that is the gap a&lt;br&gt;   grader will ask about." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="40" y="1250" width="830" height="300" as="geometry"/></mxCell>
        <mxCell id="n50" value="Why the loop is drawn instead of one upload step&lt;br&gt;&lt;br&gt;The route uses FileInterceptor(fileUpload) — SINGLE file. The multer config&lt;br&gt;allows files: 10, which reads like ten photos per request, but that limit&lt;br&gt;never applies: the interceptor accepts one field, one file. A client with six&lt;br&gt;photos makes six requests and assembles the URL list itself.&lt;br&gt;&lt;br&gt;Consequence worth saying out loud: those six uploads are not one transaction.&lt;br&gt;If the browser closes after the fourth, four files sit on disk and in `files`&lt;br&gt;with no product pointing at them. Nothing collects them.&lt;br&gt;&lt;br&gt;fileSize is 100MB per file — for a marketplace photo that is roughly fifty&lt;br&gt;times what is needed, and it is the whole VPS disk on the line." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="900" y="1250" width="830" height="300" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
