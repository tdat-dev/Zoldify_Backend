<mxfile host="app.diagrams.net" type="device">
  <diagram id="d1" name="State Machine - Order Lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value="pending" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="120" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n3" value="confirmed" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n4" value="processing" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n5" value="shipping" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="510" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n6" value="delivered" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#d5f5dd;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n7" value="cancelled" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffe0e0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="120" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n8" value="refunded" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#ffe0e0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="490" y="420" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="n9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="810" y="290" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n10" value="buyer places order" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="seller accepts" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n12" value="preparing goods" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="GHN shipment created" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n14" value="buyer confirms receipt" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="ship directly" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="277"/><mxPoint x="50" y="537"/></Array></mxGeometry></mxCell>
        <mxCell id="n16" value="cancel before acceptance" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="cancel after acceptance" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n18" value="admin refunds" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n19" value="admin refunds" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n20" value="nothing was paid" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="REFUND escrow" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n22" value="RELEASE escrow" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="684"/></Array></mxGeometry></mxCell>
        <mxCell id="n23" value="Every arrow into the final state moves money. That is why authorization on&lt;br&gt;this state machine is a financial control, not a UX detail.&lt;br&gt;&lt;br&gt;Who may make each move — enforced by order-status.policy.ts:&lt;br&gt;  confirmed / processing / shipping ....... seller or admin&lt;br&gt;  delivered ............................... BUYER or admin, and only from shipping&lt;br&gt;  refunded ................................ admin only&lt;br&gt;  cancelled ............................... neither; use /cancel or /cancel-sale,&lt;br&gt;                                            those also restore stock&lt;br&gt;&lt;br&gt;The principle: whoever gains must not be the one who presses the button.&lt;br&gt;A seller marking their own order delivered would be releasing their own escrow." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="700" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
