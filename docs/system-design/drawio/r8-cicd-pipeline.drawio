        <mxCell id="n6" value="test&lt;br&gt;money runs on real MySQL" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="370" y="220" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="n7" value="build" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="n8" value="openapi:check&lt;br&gt;differs from commit means fail" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe8cc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="155" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="n9" value="diagrams:check + drawio:check&lt;br&gt;Mermaid and draw.io must both parse" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe8cc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="640" y="220" width="230" height="50" as="geometry"/></mxCell>
        <mxCell id="n10" value="All green?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff8e1;strokeColor=#b8860b;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="n11" value="Reviewed by&lt;br&gt;another member" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="150" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n12" value="Merge into develop" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="240" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n13" value="Merge develop into main" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n14" value="Build image,&lt;br&gt;push to GHCR" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe0e0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n15" value="SSH to VPS&lt;br&gt;compose pull and up -d" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe0e0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="510" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n16" value="Run migrations&lt;br&gt;service `migrate`, chạy trước api" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="990" y="600" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n17" value="/api/v1/health&lt;br&gt;ok?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff8e1;strokeColor=#b8860b;" vertex="1" parent="1"><mxGeometry x="1010" y="690" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="n18" value="Roll back to&lt;br&gt;previous image" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffe0e0;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="700" y="700" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="n19" value="Done" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#d5f5dd;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1010" y="810" width="180" height="50" as="geometry"/></mxCell>
        <mxCell id="n20" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n21" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n2" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n22" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="365"/><mxPoint x="310" y="85"/></Array></mxGeometry></mxCell>
        <mxCell id="n23" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n24" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n25" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n26" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n27" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n28" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="fails" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="ok" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n32" value="The three orange gates are what makes the architecture hold over time.&lt;br&gt;&lt;br&gt;boundaries:check turns the context dependency rule from a spoken agreement&lt;br&gt;into a merge blocker. Without it the rule is broken within two weeks.&lt;br&gt;&lt;br&gt;openapi:check guarantees web and mobile never build against a stale contract.&lt;br&gt;&lt;br&gt;diagrams:check means a broken diagram cannot be merged — the report depends&lt;br&gt;on them rendering.&lt;br&gt;&lt;br&gt;NOT BUILT YET: the backend has no .github/workflows at all. This is B, week 1." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="n33" value="The red column is a plan, not a description&lt;br&gt;&lt;br&gt;There is no Dockerfile and no compose file in any of the four repositories.&lt;br&gt;The only container in the project is started by scripts/test-db.mjs with a&lt;br&gt;bare `docker run mysql:8` for the test database.&lt;br&gt;&lt;br&gt;Dockerfile and docker-compose.yml now exist, and `docker compose up -d --build`&lt;br&gt;has been run from an empty volume: 25 tables migrated, both containers healthy,&lt;br&gt;/api/v1/products answering. So the migration step is real and is drawn black.&lt;br&gt;&lt;br&gt;The two boxes still red need things that do not exist: there is no&lt;br&gt;.github/workflows anywhere, so nothing builds or pushes an image; and there is&lt;br&gt;no VPS to ssh into. Until then a deploy is `git pull` then `npm run docker:up`&lt;br&gt;on the machine itself, which builds locally and skips GHCR entirely." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="n34" value="This pipeline runs per repository. Four repositories:&lt;br&gt;&lt;br&gt;Zoldify_Backend    lint · boundaries:check · test · build · openapi:check · diagrams:check&lt;br&gt;Zoldify_Frontend   lint · build · gen:api must match the committed schema&lt;br&gt;Zoldify_Admin      lint · build · check-shared must match Zoldify_Frontend   (planned)&lt;br&gt;Zoldify_Mobile     lint · typecheck · EAS build&lt;br&gt;&lt;br&gt;check-shared is the gate specific to the admin split: the modules copied from&lt;br&gt;the shop repo must stay byte-identical. Without it the two copies drift, which&lt;br&gt;is exactly how the order-status table ended up with four versions." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="620" height="190" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
