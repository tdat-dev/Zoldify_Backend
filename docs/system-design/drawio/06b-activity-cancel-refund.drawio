        <mxCell id="n27" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n28" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n29" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n30" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n31" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n32" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="690"/><mxPoint x="1020" y="882"/></Array></mxGeometry></mxCell>
        <mxCell id="n33" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n34" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n35" value="COMMIT" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n36" value="yes" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n37" value="no" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n18" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n38" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n39" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1210"/></Array></mxGeometry></mxCell>
        <mxCell id="n40" value="Why the dashed frame — and the bug it replaced&lt;br&gt;&lt;br&gt;The refund, the status change and the stock restore are ONE transaction. If&lt;br&gt;the refund throws, none of the other two happened: the order stays open and&lt;br&gt;the buyer can try again.&lt;br&gt;&lt;br&gt;Until 14 Aug this was three separate writes, and the refund call sat inside a&lt;br&gt;try/catch that only console.error-ed the failure — then saved the order as&lt;br&gt;cancelled anyway. A failed refund left the buyer money in escrow_hold forever&lt;br&gt;with nothing raising an alarm. escrows.refund() was always correct on its own;&lt;br&gt;the defect was the caller swallowing what it threw.&lt;br&gt;&lt;br&gt;Exactly one failure is still swallowed on purpose: an order paid before the&lt;br&gt;escrow system existed has no escrow row to refund. That one logs a warning and&lt;br&gt;lets the cancel through. Every other error rolls the whole thing back." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="800" height="240" as="geometry"/></mxCell>
        <mxCell id="n41" value="Two safety nets, because voiding the link can fail&lt;br&gt;&lt;br&gt;Voiding runs AFTER the commit and never throws: it is a network call to PayOS,&lt;br&gt;and holding database locks across a network wait is how deadlocks are made.&lt;br&gt;If it fails, the link stays alive and someone can still pay a cancelled order.&lt;br&gt;&lt;br&gt;The second net catches that. The payment webhook now checks the order status&lt;br&gt;first: if the order is cancelled the money is credited to the BUYER WALLET and&lt;br&gt;the order stays cancelled — see 06-activity-diagram. It cannot be ignored,&lt;br&gt;because the money is already in the real bank account; not recording it would&lt;br&gt;put gateway_clearing out of step with the bank.&lt;br&gt;&lt;br&gt;Until 14 Aug neither net existed: the webhook set status = confirmed without&lt;br&gt;looking, so a cancelled order came back to life while its stock had already&lt;br&gt;been returned to the shelf." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="880" y="1340" width="800" height="240" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
