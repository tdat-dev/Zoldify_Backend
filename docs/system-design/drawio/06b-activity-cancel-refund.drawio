        <mxCell id="n19" value="Ask PayOS to void the link" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="n2"><mxGeometry x="530" y="1030" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="n20" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="n2"><mxGeometry x="305" y="1155" width="30" height="30" as="geometry"/></mxCell>
