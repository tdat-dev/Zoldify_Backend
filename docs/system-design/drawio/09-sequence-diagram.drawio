        <mxCell id="n7" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="675" y="250" width="10" height="490" as="geometry"/></mxCell>
