        <mxCell id="n10" value="1. POST /api/v1/payos/webhook" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="150" as="sourcePoint"/><mxPoint x="400" y="150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n11" value="2. verify signature" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0;entryX=1;entryY=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="190" as="sourcePoint"/><mxPoint x="405" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n12" value="3. post(key = payos:orderCode:linkId, manager)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="250" as="sourcePoint"/><mxPoint x="680" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n13" value="4. BEGIN TRANSACTION" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="290" as="sourcePoint"/><mxPoint x="950" y="290" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n14" value="5. SELECT ledger_transactions WHERE idempotency_key" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="330" as="sourcePoint"/><mxPoint x="950" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n15" value="6. found / not found" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="370" as="sourcePoint"/><mxPoint x="680" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n16" value="7. INSERT transaction, INSERT entries" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="500" as="sourcePoint"/><mxPoint x="950" y="500" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n17" value="8. SELECT ledger_accounts FOR UPDATE, UPDATE balance" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="540" as="sourcePoint"/><mxPoint x="950" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n18" value="9. UPDATE orders, INSERT escrows" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="580" as="sourcePoint"/><mxPoint x="950" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n19" value="10. COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="620" as="sourcePoint"/><mxPoint x="950" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n20" value="11. LedgerTransaction" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="660" as="sourcePoint"/><mxPoint x="400" y="660" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n21" value="12. notify buyer, after commit" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="780" as="sourcePoint"/><mxPoint x="1220" y="780" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n22" value="13. 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="830" as="sourcePoint"/><mxPoint x="130" y="830" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n23" value="alt  [key is new]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=190;height=26;fontSize=11;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="590" y="470" width="480" height="200" as="geometry"/></mxCell>
        <mxCell id="n24" value="Steps 4 to 10 are ONE transaction. The idempotency key and the money share a fate:&lt;br&gt;a crash rolls both back, so the retry succeeds cleanly. The old code committed the&lt;br&gt;key first, so a crash silently swallowed the payment." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="660" height="80" as="geometry"/></mxCell>
        <mxCell id="n25" value="else [key already used]&lt;br&gt;Return the existing transaction and move no money.&lt;br&gt;This is the normal path when PayOS resends, not an error." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="780" y="990" width="540" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
