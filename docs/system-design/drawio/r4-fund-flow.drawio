<mxfile host="app.diagrams.net" type="device">
  <diagram id="d1" name="Fund Flow Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="gateway_clearing&lt;br&gt;money arriving from PayOS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#eef6ff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n2" value="buyer.available&lt;br&gt;buyer wallet" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="100" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n3" value="escrow_hold&lt;br&gt;held by Zoldify" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffd700;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="380" y="320" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n4" value="seller.available&lt;br&gt;seller wallet" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="200" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n5" value="platform.revenue&lt;br&gt;Zoldify revenue" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#90ee90;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="420" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n6" value="seller.withdrawal_pending&lt;br&gt;awaiting manual payout" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#fff3cd;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="200" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n7" value="bank_external&lt;br&gt;left the system" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;align=center;fillColor=#e8e8e8;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1050" y="380" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="n8" value="1 · wallet top-up" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n9" value="1b · order paid via PayOS" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n10" value="2 · place order" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n11" value="4 · refund" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="n3" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n12" value="3a · delivered, 95%" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n13" value="3b · platform fee, 5%" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n14" value="5 · seller requests" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n15" value="6a · rejected" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="n6" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n16" value="6b · transfer completed" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n17" value="The yellow box is the single most important number in the system. Its balance&lt;br&gt;must always equal the real money sitting in Zoldify's bank account.&lt;br&gt;&lt;br&gt;It answers the first question any auditor, investor or payment partner asks:&lt;br&gt;&quot;How much of your users' money are you holding, and how do you prove it?&quot;&lt;br&gt;One SQL query. The old architecture could not answer it at all.&lt;br&gt;&lt;br&gt;Steps 5 and 6 are separate because the payout is a human action. Between them&lt;br&gt;the money has left the seller's wallet but not the system — without a dedicated&lt;br&gt;account for that state, the books cannot be reconciled against the bank." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;fillColor=#fffbe6;strokeColor=#c8a415;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="720" height="160" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
